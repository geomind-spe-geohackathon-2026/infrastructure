# Stack
API_PORT=8000
FRONTEND_PORT=5173
POSTGRES_PORT=5432


# Application
APP_NAME=swarmax-backend
APP_ENV=development
APP_DEBUG=false
APP_LOG_LEVEL=INFO
APP_VERSION=0.1.0
APP_CORS_ORIGINS='["http://localhost:5173"]'


# Security
JWT_SECRET_KEY=replace-with-a-random-64-character-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14


# First admin, created at startup when no admin exists
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=replace-with-first-admin-password


# PostgreSQL. The password goes into a URL, so use URL-safe characters
POSTGRES_USER=admin
POSTGRES_PASSWORD=replace-with-postgres-password
POSTGRES_DB=swarmax
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10


# Redis. The password goes into a URL, so use URL-safe characters
REDIS_PASSWORD=replace-with-redis-password


# Rate limit
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60


# Project import, limit on the upload and on its unpacked size
PROJECT_IMPORT_MAX_BYTES=100000000


# MinIO
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=replace-with-minio-password
MINIO_SECURE=false
MINIO_BUCKET_NAME=swarmax


# InfluxDB
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=replace-with-influxdb-password
INFLUXDB_TOKEN=replace-with-influxdb-token
INFLUXDB_ORG=swarmax
INFLUXDB_BUCKET=swarmax


# OpenRouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=replace-with-openrouter-api-key
